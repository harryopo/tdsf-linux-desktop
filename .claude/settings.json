{
  "hooks": {
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "cd tdsf-linux-desktop && pnpm typecheck:node && pnpm typecheck:web && pnpm types:tests && node scripts/quality/scripts-syntax-check.cjs && pnpm lint",
            "timeout": 300
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "node scripts/hooks/pre-edit-check.cjs",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
