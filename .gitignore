# Dependencies
node_modules/

# Build output
out/
dist/
release/
release-fresh/
release-build/

# IDE
.idea/
.vscode/
*.swp

# OS
.DS_Store
Thumbs.db

# Logs
*.log
npm-debug.log*

# Environment
.env
.env.local
# 申报给 history-env-scan 的额外密钥（模型 API 口令等）：只在本机存在，闸按值核历史
.secrets-anchor.local.json

# E2E 本地凭据（SSH 密码 / API Key 等，绝不提交）+ 临时测试产物
**/.ssh-credentials.local.json
**/*-credentials.local.json
.tmp-*.log
.tmp-*.json

# Legacy Python code (reference only)
_legacy-python/__pycache__/
_legacy-python/.mypy_cache/
_legacy-python/.pytest_cache/
_legacy-python/.ruff_cache/

# scripts/ 编译产物（tsx 跑出的 .cjs 不入库）
scripts/.cjs/
scripts/*.cjs

# electron-vite 临时配置（dev 模式下动态生成）
electron.vite.config.*.mjs

# Testing
coverage/
test-results/
playwright-report/

# E2E 截图（本地调试 + 视觉回归基线，不入库）
tests/e2e/screenshots*/
tests/e2e/screenshots-acceptance/

# CodeGraph 本地索引（不入库）
.codegraph/

# AI 协作 - 本地 session 缓存（不入库，按机器隔离）
scripts/ai-coordination/.ai-session.local

# AI 协作 - 临时 scratch
.ai-scratch/

# 浏览器检查截图（本地调试用，不入库）
scripts/browser-check/screenshots-fresh/

# 字典备份文件（不入库）
src/renderer/src/assets/dict/*.bak.json

# 调研文档草稿（不入库，正式发布才纳入 docs/）
docs/skill-research/*-草稿.md
docs/skill-research/*-draft.md

# dict-import 抓取缓存（不入库，可重新抓取）
scripts/dict-import/.cache/

# 工作区收纳进来的停用目录（含各自 node_modules，不入库）
/_legacy/

# desktop 仓库自己的第二个 worktree（分支 feat/translate-v1.5.0），
# 历史在主仓库对象库里，但绝不能被外层工作树 add 进去
/tdsf-translate-v140/

# 视觉基线是【本机字体的尺子】，跨机器会误报，所以不入库（理由见 tests/e2e/visual.spec.ts 文件头）
tests/e2e/visual.spec.ts-snapshots/

# design-contract 的"改错文档数字"判据临时改 DESIGN.md 时落的字节备份（正常跑完即删；
# 留着就说明那一轮在改动与还原之间被中途杀掉过，下一轮开跑会还原并当场报红）
/DESIGN.md.tdsf-test-bak
