registry=https://registry.npmmirror.com
electron_mirror=https://npmmirror.com/mirrors/electron/
electron_builder_binaries_mirror=https://npmmirror.com/mirrors/electron-builder-binaries/
# sharp（@xenova/transformers 的传递依赖）的 install 脚本默认去 GitHub Releases 取预编译包，
# 这台网络取不到就整场 install 半途失败（2026-10-12 实测：sharp: Installation error: Request timed out）。
# 实测教训：pnpm 不会把下面这两个自定义键当 npm_config_* 转发给生命周期脚本（写了它照样连 GitHub），
# 所以生效的是命令行前缀。重装依赖时这样跑：
#   npm_config_sharp_binary_host=https://npmmirror.com/mirrors/sharp/ \
#   npm_config_sharp_libvips_binary_host=https://npmmirror.com/mirrors/sharp-libvips/ pnpm install
# 下面两行留着是给 npm/yarn 的用户和 CI 换包管理器时用，pnpm 下它不起作用，别误以为已经配好了。
sharp_binary_host=https://npmmirror.com/mirrors/sharp/
sharp_libvips_binary_host=https://npmmirror.com/mirrors/sharp-libvips/
