# =============================================================================
# TDSF-Linux Desktop 环境变量配置模板
# 复制本文件为 .env 并填写真实值
# .env 文件已在 .gitignore 中，不会被提交
# =============================================================================

# -----------------------------------------------------------------------------
# 火山方舟 LLM API (Volcano Engine Ark Runtime)
# 获取地址：https://www.volcengine.com/product/ark
# 模型推荐：doubao-seed-1-6-250615（豆包 Seed 1.6，参赛推荐）
# -----------------------------------------------------------------------------
VOLC_API_KEY=your_volcano_api_key_here
VOLC_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
VOLC_MODEL_NAME=doubao-seed-1-6-250615

# -----------------------------------------------------------------------------
# OpenAI 兼容 API（可选，作为备用 LLM 提供商）
# 支持任意 OpenAI 兼容 API：OpenAI / Azure / DeepSeek / Moonshot / 等
# -----------------------------------------------------------------------------
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL_NAME=gpt-4o

# -----------------------------------------------------------------------------
# Langfuse LLM 可观测性 (可选但推荐)
# 获取地址：https://cloud.langfuse.com
# 用于 LLM trace 可视化、Token 消耗统计、审计日志
# 参赛演示时让评委看到 trace 是重要加分项
# -----------------------------------------------------------------------------
LANGFUSE_SECRET_KEY=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com

# -----------------------------------------------------------------------------
# MCP Server 配置 (可选)
# 用于暴露 TDSF 能力给 Claude Code / Cursor 等 MCP Client
# 端口默认 3107（TDSF 谐音）
# -----------------------------------------------------------------------------
MCP_SERVER_ENABLED=false
MCP_SERVER_PORT=3107

# -----------------------------------------------------------------------------
# 应用配置
# -----------------------------------------------------------------------------
# 日志级别：debug / info / warn / error
TDSF_LOG_LEVEL=info

# 数据库路径（相对用户数据目录）
TDSF_DB_PATH=tdsf.db

# 监控采集间隔（秒）
TDSF_MONITOR_INTERVAL=3

# LLM 请求超时（秒）
TDSF_LLM_TIMEOUT=30

# 置信度阈值（低于此值触发自适应采样）
TDSF_CONFIDENCE_THRESHOLD=0.7

# 自适应采样次数
TDSF_SAMPLING_ROUNDS=3

# -----------------------------------------------------------------------------
# 开发模式配置（仅开发时使用）
# -----------------------------------------------------------------------------
# 启用 React DevTools
ELECTRON_ENABLE_LOGGING=true

# 热更新端口（electron-vite 默认 5173）
VITE_DEV_SERVER_PORT=5173

# =============================================================================
# 配置优先级说明
# 1. 环境变量（.env）> electron-store 配置 > 代码默认值
# 2. LLM API Key 优先使用 safeStorage 加密存储（用户在设置页配置）
# 3. 环境变量仅用于开发调试，生产环境由用户在应用内配置
# =============================================================================
